# RecoverLoop runs without environment variables. These settings configure the
# optional tested OpenAI planner adapter; never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=4000

# Optional signed-webhook drill. This is separate from a Razorpay API key.
RAZORPAY_WEBHOOK_SECRET=
